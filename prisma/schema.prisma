generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// Auth / Users
// ─────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         Role    @default(CUSTOMER)

  // Stripe Customer id (cus_...). Created lazily on first membership signup.
  stripeCustomerId String? @unique

  emailVerified           Boolean   @default(false)
  emailVerifyTokenHash    String?
  emailVerifyTokenExpires DateTime?

  passwordResetTokenHash    String?
  passwordResetTokenExpires DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens        RefreshToken[]
  addresses            Address[]
  subscriptions        Subscription[]
  cart                 Cart?
  orders               Order[]
  couponUsages         CouponUsage[]
  notifications        NotificationLog[]
  inventoryAdjustments InventoryAdjustment[]

  @@map("users")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("US")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  ordersAsShipping Order[]        @relation("ShippingAddress")
  ordersAsBilling  Order[]        @relation("BillingAddress")
  subscriptions    Subscription[] @relation("SubscriptionShippingAddress")

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?
  parentId    Int?
  sortOrder   Int     @default(0)

  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products ProductCategory[]

  @@map("categories")
}

enum ProductType {
  SUBSCRIPTION_ITEM
  ONE_TIME
  ACCESSORY
  MERCHANDISE
  GIFT_MEMBERSHIP
}

model Product {
  id             Int         @id @default(autoincrement())
  name           String
  slug           String      @unique
  description    String?     @db.Text
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  sku            String?     @unique
  type           ProductType @default(ONE_TIME)
  isFeatured     Boolean     @default(false)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  images          ProductImage[]
  categories      ProductCategory[]
  inventory       Inventory?
  cartItems       CartItem[]
  orderItems      OrderItem[]
  membershipPlans MembershipPlan[]  @relation("PlanShipmentProduct")
  eventProducts   EventProduct[]

  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  url       String
  altText   String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductCategory {
  productId  Int
  categoryId Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

// ─────────────────────────────────────────────────────────
// Memberships / Subscriptions
// ─────────────────────────────────────────────────────────

enum BillingFrequency {
  MONTHLY
  ANNUAL
}

model MembershipPlan {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  description      String?          @db.Text
  price            Decimal          @db.Decimal(10, 2)
  billingFrequency BillingFrequency @default(MONTHLY)
  benefits         Json?
  maxProducts      Int?
  isActive         Boolean          @default(true)
  displayOrder     Int              @default(0)

  // The cigar shipped to a member every billing cycle, and how many of it.
  productId    Int?
  product      Product? @relation("PlanShipmentProduct", fields: [productId], references: [id])
  shipQuantity Int      @default(1)
  imageUrl     String?
  tagline      String?

  subscriptions Subscription[]

  @@map("membership_plans")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  userId             Int
  planId             Int
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextBillingDate    DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Where the monthly box ships. Snapshotted onto each shipment Order too.
  shippingAddressId Int?
  shippingAddress   Address? @relation("SubscriptionShippingAddress", fields: [shippingAddressId], references: [id])

  // Payment-provider handles (stub today, real gateway later).
  providerCustomerId     String?
  providerSubscriptionId String?
  paymentMethodLabel     String?

  // Self-service + dunning state.
  pausedUntil        DateTime?
  skipNextCycle      Boolean   @default(false)
  failedPaymentCount Int       @default(0)
  lastPaymentAt      DateTime?

  user     User                  @relation(fields: [userId], references: [id])
  plan     MembershipPlan        @relation(fields: [planId], references: [id])
  payments SubscriptionPayment[]
  orders   Order[]

  @@index([userId])
  @@index([status, nextBillingDate])
  @@map("subscriptions")
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model SubscriptionPayment {
  id             Int                       @id @default(autoincrement())
  subscriptionId Int
  amount         Decimal                   @db.Decimal(10, 2)
  status         SubscriptionPaymentStatus @default(PENDING)
  attemptNumber  Int                       @default(1)
  providerRef    String?
  createdAt      DateTime                  @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  payment      Payment?

  @@index([subscriptionId])
  @@map("subscription_payments")
}

// ─────────────────────────────────────────────────────────
// Cart / Orders
// ─────────────────────────────────────────────────────────

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id         Int     @id @default(autoincrement())
  cartId     Int
  productId  Int
  quantity   Int     @default(1)
  priceAtAdd Decimal @db.Decimal(10, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@map("cart_items")
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum OrderType {
  ONE_TIME
  SUBSCRIPTION
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  type              OrderType   @default(ONE_TIME)
  status            OrderStatus @default(PENDING_PAYMENT)
  subtotal          Decimal     @db.Decimal(10, 2)
  tax               Decimal     @default(0) @db.Decimal(10, 2)
  shipping          Decimal     @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  shippingAddressId Int?
  billingAddressId  Int?
  subscriptionId    Int?
  eventId           Int?
  trackingNumber    String?
  placedAt          DateTime    @default(now())

  event           Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user            User                 @relation(fields: [userId], references: [id])
  shippingAddress Address?             @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  Address?             @relation("BillingAddress", fields: [billingAddressId], references: [id])
  subscription    Subscription?        @relation(fields: [subscriptionId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payment         Payment?
  couponUsages    CouponUsage[]

  @@index([userId])
  @@index([subscriptionId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  status    OrderStatus
  note      String?
  changedAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ─────────────────────────────────────────────────────────
// Payments (provider-agnostic ledger)
// ─────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                    Int           @id @default(autoincrement())
  orderId               Int?          @unique
  subscriptionPaymentId Int?          @unique
  provider              String
  providerRef           String?
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  createdAt             DateTime      @default(now())

  order               Order?               @relation(fields: [orderId], references: [id])
  subscriptionPayment SubscriptionPayment? @relation(fields: [subscriptionPaymentId], references: [id])

  @@map("payments")
}

// ─────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────

model Inventory {
  id                Int      @id @default(autoincrement())
  productId         Int      @unique
  sku               String?
  stockQty          Int      @default(0)
  reservedQty       Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  adjustments InventoryAdjustment[]

  @@map("inventory")
}

model InventoryAdjustment {
  id               Int      @id @default(autoincrement())
  inventoryId      Int
  changeQty        Int
  reason           String?
  adjustedByUserId Int?
  createdAt        DateTime @default(now())

  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  adjustedByUser User?     @relation(fields: [adjustedByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@map("inventory_adjustments")
}

// ─────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────

model Event {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String?   @db.Text
  location    String?
  startAt     DateTime
  endAt       DateTime?
  imageUrl    String?
  isPublished Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // Members-only sale: the products listed here can be bought at
  // `discountPercent` off, but only by an active member and only while the
  // event is on (see orders checkout).
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  products EventProduct[]
  orders   Order[]

  @@map("events")
}

model EventProduct {
  eventId   Int
  productId Int

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([eventId, productId])
  @@index([productId])
  @@map("event_products")
}

// ─────────────────────────────────────────────────────────
// Coupons
// ─────────────────────────────────────────────────────────

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  type        CouponType
  value       Decimal    @default(0) @db.Decimal(10, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  usageLimit  Int?
  minPurchase Decimal?   @db.Decimal(10, 2)
  isActive    Boolean    @default(true)

  usages CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id       Int      @id @default(autoincrement())
  couponId Int
  userId   Int
  orderId  Int?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@map("coupon_usages")
}

// ─────────────────────────────────────────────────────────
// Notifications / Settings
// ─────────────────────────────────────────────────────────

model EmailTemplate {
  id       Int     @id @default(autoincrement())
  key      String  @unique
  subject  String
  bodyHtml String  @db.Text
  isActive Boolean @default(true)

  @@map("email_templates")
}

model NotificationLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  type      String
  channel   String   @default("EMAIL")
  recipient String
  status    String   @default("SENT")
  sentAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notification_logs")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value Json

  @@map("settings")
}
