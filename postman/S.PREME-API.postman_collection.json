        },
        {
          "name": "Delete Customer (Admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{customerId}}"
              ]
            },
            "description": "Hard-deletes the user if they have no orders/subscriptions/coupon usage; otherwise deactivates them instead (response: { deactivated: true|false }). Fails with 400 if {{customerId}} is your own logged-in account."
          }
