              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(function () {",
                  "  if (pm.response.code < 300) {",
                  "    const data = pm.response.json();",
                  "    const first = (data.items || [])[0];",
                  "    if (first) { pm.collectionVariables.set('customerId', String(first.id)); }",
                  "  }",
                  "})();"
                ]
              }
            }
          ]
