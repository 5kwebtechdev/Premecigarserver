# --- App ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database (MySQL) ---
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Default below matches a local XAMPP MySQL install (root, no password).
DATABASE_URL="mysql://root:@localhost:3306/premecigar"

# --- Auth ---
ACCESS_TOKEN_SECRET=replace_with_a_long_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=preme_refresh_token

# --- CORS (customer site / admin panel origins) ---
CLIENT_WEB_ORIGIN=http://localhost:5173
CLIENT_ADMIN_ORIGIN=http://localhost:5174

# --- Mail / SMTP ---
# Leave SMTP_HOST/USER/PASS blank in dev to log emails to the console instead
# of sending them. Fill them in to send for real. Examples:
#   Gmail   host=smtp.gmail.com  port=465 secure=true   (user = address, pass = App Password)
#   Brevo   host=smtp-relay.brevo.com  port=587
#   Mailtrap host=sandbox.smtp.mailtrap.io port=587     (safe inbox for testing)
APP_NAME="S.PREME Cigar Co."
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE: true = implicit TLS (port 465); leave blank to auto-pick (STARTTLS on 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="S.PREME Cigar Co. <no-reply@spremecigar.com>"
# Optional: address customer replies go to (defaults to none).
MAIL_REPLY_TO=

# Verify credentials without touching the app:  npm run mail:test you@example.com

# --- Frontend URL used to build links inside emails ---
WEB_APP_URL=http://localhost:5173

# --- Public origin of THIS API (used to build absolute URLs for uploaded images) ---
SERVER_PUBLIC_URL=http://129.121.143.200:4000

# --- Recurring billing ---
# Consecutive failed subscription charges before the membership is auto-cancelled.
BILLING_MAX_FAILED_PAYMENTS=3
# Days before nextBillingDate to send the renewal-reminder email.
RENEWAL_REMINDER_DAYS=3
# Where low-stock / ops alerts are emailed. Blank = email every ADMIN user.
ADMIN_NOTIFY_EMAIL=

# --- Stripe (memberships) ---
# Leave STRIPE_SECRET_KEY blank to keep using the stub provider.
# Test keys: https://dashboard.stripe.com/test/apikeys  (sk_test_... / pk_test_...)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dev: run `stripe listen --forward-to localhost:4000/api/v1/payments/webhook` and paste its whsec_...
# Prod: the webhook endpoint's "Signing secret" from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
